LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

MAX_DISTANCE=0.75

# Optional when Tesseract is installed outside PATH (Windows example):
# TESSERACT_CMD="C:/Program Files/Tesseract-OCR/tesseract.exe"
# Optional; install the matching Tesseract language data first (e.g. eng+hin).
# OCR_LANG=eng
